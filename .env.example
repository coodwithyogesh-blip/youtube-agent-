# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=change_to_random_secret
TELEGRAM_OWNER_ID=
TELEGRAM_GROUP_ID=

# YouTube OAuth (Google Cloud Web application credentials)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_CHANNEL_ID=

# AI reply drafts (optional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Security
MANAGER_API_TOKEN=change_to_long_random_secret
AUTO_REPLY_MODE=approval_required

# Upload request limit (Render web request body limit may apply too)
MAX_UPLOAD_MB=90
