# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=change_to_random_secret
TELEGRAM_OWNER_ID=
TELEGRAM_GROUP_ID=

# YouTube OAuth (Google Cloud Web application credentials)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_CHANNEL_ID=

# Gemini AI: required for video analysis, SEO metadata and AI comment replies
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash

# Security
MANAGER_API_TOKEN=change_to_long_random_secret
AUTO_REPLY_MODE=automatic
COMMENT_POLL_SECONDS=900

# Telegram Bot API download limit is 20 MB per file
# Dashboard upload request limit (Render may impose its own limit)
MAX_UPLOAD_MB=90
